APP_NAME="Inventory Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=prometheus-db
DB_PORT=3306
DB_DATABASE=inventory_manager
DB_USERNAME=inventory_manager_user
DB_PASSWORD=inventory_manager_pass

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=prometheus-cache
REDIS_PORT=6379
REDIS_PASSWORD=null
